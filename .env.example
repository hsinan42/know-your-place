# Copy to .env locally. Use file permissions 600 in production.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Use a random hexadecimal value, for example generated by openssl rand -hex 32.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
# On the first migration only, point to the verified SQLite file mounted in the API container.
# SQLITE_IMPORT_PATH=/data/finance.db
DOMAIN=finance.example.com
ACME_EMAIL=you@example.com
IMAGE_PREFIX=ghcr.io/your-github-user/know-your-place
IMAGE_TAG=replace-with-commit-sha
# Direct-IP HTTP deployment is explicit opt-in; PWA installation requires HTTPS.
ALLOW_HTTP=false
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088
